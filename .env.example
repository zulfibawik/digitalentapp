# .env.example
# Salin file ini ke .env dan sesuaikan isinya (jika diperlukan).
# Sesuai docker-compose.yml, nilai-nilai di bawah ini yang dipakai
# oleh service `python` (via env) dan service `db` (via env).

# Koneksi MySQL (dipakai aplikasi Python)
DB_HOST=db
DB_PORT=3306
DB_USER=digitalenta
DB_PASSWORD=digitalenta_pass
DB_NAME=digitalenta_db

# MySQL root & bootstrap (dipakai service `db` di docker-compose)
MYSQL_ROOT_PASSWORD=root_password_rahasia
MYSQL_DATABASE=digitalenta_db
MYSQL_USER=digitalenta
MYSQL_PASSWORD=digitalenta_pass
